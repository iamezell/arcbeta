<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <style>
    :root { color-scheme: dark; }
    body {
      margin: 0; min-height: 100vh; background: radial-gradient(circle at 50% 0%, #16203a, #0a0c12 60%);
      color: #e8f0ff; font-family: 'Segoe UI', Tahoma, sans-serif; display: flex; flex-direction: column;
      align-items: center; padding: 32px 16px;
    }
    h1 { margin: 0; font-size: 30px; color: #9fd0ff; letter-spacing: 0.5px; }
    .tag { opacity: 0.65; margin: 6px 0 24px; font-size: 16px; }
    .card {
      background: rgba(20,24,34,0.85); border: 1px solid rgba(120,200,255,0.22); border-radius: 16px;
      padding: 24px; width: min(560px, 94vw); box-shadow: 0 10px 40px rgba(0,0,0,0.45);
    }
    .qr-wrap { background: #fff; padding: 14px; border-radius: 14px; width: 320px; max-width: 80vw; margin: 0 auto 18px; }
    .qr-wrap img { width: 100%; display: block; }
    .joinurl {
      display: flex; gap: 8px; align-items: center; justify-content: center; flex-wrap: wrap; margin-bottom: 8px;
    }
    .joinurl code {
      font-size: 18px; color: #8fe7c0; background: #11151f; padding: 8px 12px; border-radius: 8px; word-break: break-all;
    }
    button {
      background: #233048; color: #cfe2ff; border: 0; border-radius: 8px; padding: 10px 16px; font-size: 14px;
      cursor: pointer;
    }
    button:hover { background: #2e3e5c; }
    button.primary { background: #2a7d5c; color: #fff; }
    button.primary:hover { background: #349670; }
    .showcode { text-align: center; font-size: 18px; margin: 14px 0; }
    .showcode b { color: #ffcf8f; letter-spacing: 2px; }
    .warn { background: #4a2020; border: 1px solid #a55; padding: 10px 14px; border-radius: 8px; margin-bottom: 16px; }
    .alts { text-align: center; opacity: 0.6; font-size: 13px; margin-top: 6px; }
    h2 { font-size: 16px; color: #ffcf8f; border-bottom: 1px solid #2a3142; padding-bottom: 6px; margin-top: 26px; }
    ul.people { list-style: none; padding: 0; margin: 0; }
    ul.people li { display: flex; align-items: center; gap: 10px; padding: 8px 4px; border-bottom: 1px solid #1b202c; }
    .slot { background: #233048; color: #9fd0ff; border-radius: 6px; min-width: 26px; text-align: center; padding: 3px 6px; font-weight: 700; font-size: 12px; }
    .pname { font-weight: 600; }
    .pmeta { opacity: 0.55; font-size: 12px; margin-left: auto; }
    .empty { opacity: 0.5; padding: 10px 0; }
    .row { display: flex; gap: 10px; justify-content: center; margin-top: 12px; flex-wrap: wrap; }
  </style>
</head>
<body>
  <h1>ARC Local Rehearsal</h1>
  <p class="tag">Scan to Join</p>

  <div class="card">
    <% if (info.fallback) { %>
      <div class="warn">⚠️ Could not detect a LAN IP. Showing localhost — phones on Wi-Fi won't reach this.
        Connect to Wi-Fi and press Refresh.</div>
    <% } %>

    <div class="qr-wrap">
      <img id="qr" alt="Join QR code" src="/director/qr.svg?url=<%= encodeURIComponent(info.joinUrl) %>" />
    </div>

    <div class="joinurl">
      <code id="joinUrl"><%= info.joinUrl %></code>
    </div>
    <div class="row">
      <button class="primary" id="copyBtn">Copy URL</button>
      <button id="refreshBtn">Refresh network info</button>
    </div>
    <% if (info.hostname) { %>
      <p class="alts">Also try: https://<%= info.hostname %><%= info.frontendPort === 443 ? '' : ':' + info.frontendPort %>/join</p>
    <% } %>
    <% if (info.localIps.length > 1) { %>
      <p class="alts">Other addresses: <%= info.localIps.join(', ') %></p>
    <% } %>

    <div class="showcode">Show Code: <b><%= showCode %></b></div>

    <h2>Connected (<span id="count">0</span>)</h2>
    <ul class="people" id="people"><li class="empty">No one yet — scan the code to join.</li></ul>
  </div>

  <script>
    const joinUrl = <%- JSON.stringify(info.joinUrl) %>;

    document.getElementById('copyBtn').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(joinUrl); const b = document.getElementById('copyBtn');
        b.textContent = 'Copied!'; setTimeout(() => (b.textContent = 'Copy URL'), 1200); } catch (e) {}
    });
    document.getElementById('refreshBtn').addEventListener('click', () => location.reload());

    function deviceIcon(d) { return d === 'phone' ? '📱' : d === 'headset' ? '🥽' : d === 'desktop' ? '💻' : '❓'; }

    async function refreshPeople() {
      try {
        const res = await fetch('/director/participants');
        const data = await res.json();
        const list = document.getElementById('people');
        document.getElementById('count').textContent = data.participants.length;
        if (!data.participants.length) {
          list.innerHTML = '<li class="empty">No one yet — scan the code to join.</li>';
          return;
        }
        list.innerHTML = data.participants.map((p) => {
          const slot = p.slot ? '<span class="slot">' + p.slot + '</span>' : '<span class="slot">·</span>';
          return '<li>' + slot +
            '<span class="pname">' + escapeHtml(p.name) + '</span>' +
            '<span class="pmeta">' + escapeHtml(p.role) + ' ' + deviceIcon(p.deviceType) + '</span></li>';
        }).join('');
      } catch (e) { /* server not ready */ }
    }
    function escapeHtml(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}

    refreshPeople();
    setInterval(refreshPeople, 2500);
  </script>
</body>
</html>
