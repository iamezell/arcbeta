<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title><%= title %></title>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; background: radial-gradient(circle at 50% 0%, #16203a, #0a0c12 60%);
      color: #e8f0ff; font-family: 'Segoe UI', Tahoma, sans-serif; display: flex; flex-direction: column;
      align-items: center; justify-content: flex-start; padding: 28px 18px 48px;
    }
    h1 { margin: 6px 0 2px; font-size: 34px; color: #9fd0ff; letter-spacing: 1px; }
    .tag { opacity: 0.7; margin: 0 0 22px; font-size: 18px; }
    .show { opacity: 0.6; font-size: 15px; margin-bottom: 22px; }
    .show b { color: #ffcf8f; letter-spacing: 2px; }
    .card { width: min(440px, 100%); display: flex; flex-direction: column; gap: 16px; }
    label { font-size: 15px; opacity: 0.8; margin-bottom: -8px; }
    input {
      font-size: 20px; padding: 16px; border-radius: 12px; border: 1px solid rgba(120,200,255,0.3);
      background: #11151f; color: #fff; width: 100%;
    }
    .roles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .role-btn {
      font-size: 18px; padding: 16px; border-radius: 12px; border: 2px solid rgba(120,200,255,0.2);
      background: #1a2030; color: #cfe2ff; cursor: pointer; text-align: center;
    }
    .role-btn.active { border-color: #2a7d5c; background: #1f4a3a; color: #b6f5d6; }
    button.join {
      font-size: 22px; padding: 18px; border-radius: 14px; border: 0; background: #2a7d5c; color: #fff;
      cursor: pointer; font-weight: 700; margin-top: 4px;
    }
    button.join:active { background: #349670; }
    button.quick {
      font-size: 18px; padding: 16px; border-radius: 14px; border: 1px solid rgba(120,200,255,0.3);
      background: #233048; color: #cfe2ff; cursor: pointer;
    }
    .or { text-align: center; opacity: 0.5; font-size: 14px; }
    .note { opacity: 0.55; font-size: 13px; text-align: center; line-height: 1.4; margin-top: 4px; }
  </style>
</head>
<body>
  <h1>ARC</h1>
  <p class="tag">Join Rehearsal</p>
  <p class="show">Show Code: <b><%= showCode %></b></p>

  <div class="card">
    <button class="quick" id="quickJoin">⚡ Quick Join as Audience</button>
    <p class="or">— or —</p>

    <label for="name">Your name</label>
    <input id="name" type="text" inputmode="text" autocomplete="off" placeholder="e.g. Marcus" />

    <label>Role</label>
    <div class="roles" id="roles">
      <div class="role-btn active" data-role="Audience">Audience</div>
      <div class="role-btn" data-role="Actor">Actor</div>
      <div class="role-btn" data-role="Host">Host</div>
      <div class="role-btn" data-role="Director">Director</div>
    </div>

    <button class="join" id="joinBtn">Join the Show</button>
    <p class="note">Audio starts after you tap Join. On phones, movement may be limited in this build.</p>
  </div>

  <script>
    const showCode = <%- JSON.stringify(showCode) %>;
    let role = 'Audience';

    document.querySelectorAll('.role-btn').forEach((el) => {
      el.addEventListener('click', () => {
        document.querySelectorAll('.role-btn').forEach((b) => b.classList.remove('active'));
        el.classList.add('active');
        role = el.dataset.role;
      });
    });

    // ARC's scene/role system uses Director/Actor/Audience. "Host" maps to Director.
    function normalizeRole(r) { return r === 'Host' ? 'Director' : r; }

    function go(name, chosenRole) {
      const params = new URLSearchParams({ role: normalizeRole(chosenRole), name: name, show: showCode });
      window.location.href = '/scene?' + params.toString();
    }

    document.getElementById('joinBtn').addEventListener('click', () => {
      const name = (document.getElementById('name').value || '').trim() || ('Audience ' + Math.floor(Math.random() * 90 + 10));
      go(name, role);
    });

    // Headset/quick path: no typing required — auto-generate an audience name.
    document.getElementById('quickJoin').addEventListener('click', () => {
      const n = 'Audience ' + Math.floor(Math.random() * 90 + 10);
      go(n, 'Audience');
    });

    document.getElementById('name').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') document.getElementById('joinBtn').click();
    });
  </script>
</body>
</html>
